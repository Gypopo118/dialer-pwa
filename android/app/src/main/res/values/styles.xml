<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- Интерфейс всегда тёмный (WebView принудительно color-scheme: dark),
         поэтому и Android-тема не должна следовать светлой теме телефона. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- Приложение всегда тёмное, независимо от темы телефона.
             На Android 15+ (targetSdk 35+) панель навигации с тремя кнопками
             берёт цвет из windowBackground; светлый фон окна давал белую
             полосу, которая темнела только под открытой клавиатурой. -->
        <item name="android:windowBackground">@color/dialer_background</item>
        <item name="android:navigationBarColor">@color/dialer_background</item>
        <item name="android:statusBarColor">@color/dialer_background</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <!-- Панели тёмные уже на экране заставки, без белой вспышки. -->
        <item name="android:navigationBarColor">@color/dialer_background</item>
        <item name="android:statusBarColor">@color/dialer_background</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>